# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Preview = branch `teste`, Production = principal).
# Nenhum valor real neste arquivo.

# Supabase (a integração Supabase–Vercel preenche por ambiente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cofre do certificado: 32 bytes em base64 (openssl rand -base64 32). Diferente em Preview e Production.
CERT_MASTER_KEY=
CERT_KEY_VERSION=1

# restrita | producao
NFSE_AMBIENTE=restrita
SEFIN_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
ADN_BASE_URL=https://adn.producaorestrita.nfse.gov.br/contribuintes

# Workers chamados pelo pg_cron (mesmo valor no Supabase Vault)
WORKER_SECRET=
WORKER_BUDGET_MS=50000
RETRY_MINUTOS=5,15,60

LOGIN_MAX_FALHAS=3
LOGIN_BLOQUEIO_MIN=15
PLANILHA_MAX_LINHAS=30
CERT_ALERTA_DIAS=30,15
MUNICIPIOS_ALERTA_DIAS=30

# Vercel Blob (cópia fora do banco)
BLOB_READ_WRITE_TOKEN=
# ou, com a loja Blob ligada ao projeto na Vercel (OIDC), só BLOB_STORE_ID (a Vercel preenche)
BLOB_STORE_ID=

# Só para `npm test` (branch `teste`) e para os psql do Verify Gate. Nunca o banco principal.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
PROD_SUPABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# Envio da nota ao tomador: e-mail pelo Gmail do escritório (senha de app do Google, 16 letras), WhatsApp por wa.me
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
# domínio próprio verificado no Resend: com os dois preenchidos o e-mail sai pelo Resend em vez do Gmail
RESEND_API_KEY=
EMAIL_REMETENTE=
# resposta quando a empresa não tem e-mail no cadastro; vazio usa o SMTP_USUARIO
EMAIL_ESCRITORIO=
# assina o link de 7 dias do WhatsApp (openssl rand -base64 32); vazio usa o WORKER_SECRET
ENVIO_LINK_SECRET=
# IBS/CBS do Simples na DPS (NT 009): desligado | grupo (só o grupo IBSCBS, já aceito no esquema atual) | completo (Release 4)
NFSE_IBSCBS_SIMPLES=desligado
